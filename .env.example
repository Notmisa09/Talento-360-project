PROJECT_NAME=Talento360-HR

# Desarrollo local (por defecto, no requiere SQL Server instalado)
DATABASE_URL=sqlite:///./hrm_dev.db

# Produccion (SQL Server via pyodbc) - ejemplo:
# DATABASE_URL=mssql+pyodbc://usuario:password@servidor/Talento360HR?driver=ODBC+Driver+18+for+SQL+Server

# JWT - generar una clave real para produccion, ej: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# URL del frontend, usada para armar el link del correo de "olvide mi contrasena"
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP (Gmail) - para enviar el correo de recuperacion de contrasena.
# 1. Activa la verificacion en 2 pasos en la cuenta de Gmail.
# 2. Genera una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
# 3. Usa esa contrasena de 16 caracteres aqui (no la contrasena normal de la cuenta).
# Si se dejan vacios, el correo se imprime en la consola del backend en vez de enviarse.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Talento360-HR <tu_correo@gmail.com>
