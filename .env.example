PROJECT_NAME=Talento360-HR

# Desarrollo local (por defecto, no requiere SQL Server instalado)
DATABASE_URL=sqlite:///./hrm_dev.db

# Produccion (SQL Server via pyodbc) - ejemplo:
# DATABASE_URL=mssql+pyodbc://usuario:password@servidor/Talento360HR?driver=ODBC+Driver+18+for+SQL+Server

# JWT - generar una clave real para produccion, ej: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
